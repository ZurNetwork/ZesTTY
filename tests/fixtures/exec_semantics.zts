// Executed by tests/tsc_exit.rs under node: every zts construct here must
// produce the RIGHT VALUE at runtime, not merely typecheck. Guards against
// precedence miscompiles that tsc cannot see.

function expect(name: string, got: unknown, want: unknown): void {
  if (got !== want) {
    throw new globalThis.Error(`${name}: got ${String(got)}, want ${String(want)}`);
  }
}

const c = true as boolean;

expect("plus", if (c) { 1 } else { 2 } + 1, 2);
expect("neg", -if (c) { 1 } else { 2 }, -1);
expect("index", if (c) { [7] } else { [9] }[0], 7);
expect("pow", if (c) { 2 } else { 3 } ** 2, 4);
expect("not", !if (c) { true } else { false }, false);
expect("mul", if (c) { 1 } else { 2 } * if (c) { 3 } else { 4 }, 3);
expect("typeof", typeof if (c) { 1 } else { 2 }, "number");

let seqSide = 0;
const seqVal = if (c) { (seqSide = 5), 10 } else { 0 };
expect("seq value", seqVal, 10);
expect("seq side effect", seqSide, 5);

enum Shape {
  Circle { radius: number },
  Square { side: number },
}

const sq = Shape.Square(3);
const area = match (sq) {
  Circle { radius } => {
    const r2 = radius * radius;
    3 * r2
  },
  Square { side } => side ** 2,
};
expect("match", area, 9);

const graded = if (area > 100) { "big" } else if (area > 5) { "mid" } else { "small" };
expect("chain", graded, "mid");

expect("not", not c, false);
expect("not-not", not not c, true);
expect("not-binds-tight", not c === false, true);
expect("not-in-if", if (not c) { 1 } else { 2 }, 2);

// Phase 5: literal-union match + `_` wildcard.
const level = "warn" as "debug" | "info" | "warn" | "error";
expect("lit match", match (level) { "debug" => 0, "info" => 1, "warn" => 2, "error" => 3 }, 2);

const code = -1 as -1 | 0 | 1;
expect("neg lit match", match (code) { -1 => "neg", 0 => "zero", 1 => "pos" }, "neg");

expect("bool lit match", match (c) { true => "y", false => "n" }, "y");

expect("lit wildcard", match (level) { "debug" => 0, _ => 9 }, 9);

let wildSide = 0;
const wildVal = match (sq) {
  Circle { radius } => radius,
  _ => {
    wildSide = 1;
    -1
  },
};
expect("variant wildcard value", wildVal, -1);
expect("variant wildcard side effect", wildSide, 1);

// Phase 5: newtype factories are identity casts — zero runtime cost.
newtype Meters = number;
const m = Meters(5);
expect("newtype identity", m, 5);
expect("newtype arithmetic", m + 1, 6);

console.log("exec_semantics: all assertions passed");
