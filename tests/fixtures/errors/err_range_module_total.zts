// The per-arm width cap (1024) does not bound the aggregate: the same
// memory blow-up just needs more arms, each of them individually legal.
// 65 arms at exactly the per-arm cap enumerate 66560 values — every one
// of them a literal type in the generated TypeScript, re-expanded by the
// language server on every keystroke.
declare const code: number;

export const bucket = match (code) {
  0..=1023 => 0,
  2048..=3071 => 1,
  4096..=5119 => 2,
  6144..=7167 => 3,
  8192..=9215 => 4,
  10240..=11263 => 5,
  12288..=13311 => 6,
  14336..=15359 => 7,
  16384..=17407 => 8,
  18432..=19455 => 9,
