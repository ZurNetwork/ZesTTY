  38912..=39935 => 19,
  40960..=41983 => 20,
  43008..=44031 => 21,
  45056..=46079 => 22,
  47104..=48127 => 23,
  49152..=50175 => 24,
  51200..=52223 => 25,
  53248..=54271 => 26,
  55296..=56319 => 27,
