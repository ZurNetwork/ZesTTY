declare const ready: boolean;
declare const items: string[];

// Negation forms — `not` is a reserved word since 0.4.0, always the
// operator in expression position.
const a = not ready;
const b = not not ready;
const c = if (not ready) { "wait" } else { "go" };
const d = match (({ kind: "K", ok: ready }) as { kind: "K"; ok: boolean }) {
  K { ok } => not ok,
};

// Formerly the v1 carve-outs, now negation of a parenthesized operand.
const e = not (items.length > 0);
const f = not(ready);

// Property-name positions stay legal, like ES reserved words.
const obj = { not: 1 };
const g = obj.not;

console.log(a, b, c, d, e, f, g);
