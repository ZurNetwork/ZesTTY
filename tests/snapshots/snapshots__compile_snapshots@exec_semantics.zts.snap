function __ztsAbsurd(x: never): never {
    const e: any = new globalThis.Error("zts: non-exhaustive match");
    e.ztsTag = x;
    throw e;
}
type Shape = {
    kind: "Circle";
    radius: number;
} | {
    kind: "Square";
    side: number;
};
const Shape = {
    Circle: (radius: number): Shape =>({
            kind: "Circle",
            radius
        }),
    Square: (side: number): Shape =>({
            kind: "Square",
            side
        })
};
// Executed by tests/tsc_exit.rs under node: every zts construct here must
// produce the RIGHT VALUE at runtime, not merely typecheck. Guards against
// precedence miscompiles that tsc cannot see.
function expect(name: string, got: unknown, want: unknown): void {
    if (got !== want) {
        throw new globalThis.Error(`${name}: got ${String(got)}, want ${String(want)}`);
    }
}
const c = true as boolean;
expect("plus", (c ? 1 : 2) + 1, 2);
expect("neg", -(c ? 1 : 2), -1);
expect("index", (c ? [
    7
] : [
    9
])[0], 7);
expect("pow", (c ? 2 : 3) ** 2, 4);
expect("not", !(c ? true : false), false);
expect("mul", (c ? 1 : 2) * (c ? 3 : 4), 3);
expect("typeof", typeof (c ? 1 : 2), "number");
let seqSide = 0;
const seqVal = c ? (seqSide = 5, 10) : 0;
expect("seq value", seqVal, 10);
expect("seq side effect", seqSide, 5);
const sq = Shape.Square(3);
const area = ((__m)=>{
    const __k = __m.kind;
    if (__k === "Circle") {
        const { radius } = __m;
        const r2 = radius * radius;
        return 3 * r2;
    }
    if (__k === "Square") {
        const { side } = __m;
        return side ** 2;
    }
    return __ztsAbsurd(__k);
})(sq);
expect("match", area, 9);
const graded = area > 100 ? "big" : area > 5 ? "mid" : "small";
expect("chain", graded, "mid");
expect("not", !c, false);
expect("not-not", !!c, true);
expect("not-binds-tight", !c === false, true);
expect("not-in-if", !c ? 1 : 2, 2);
// Phase 5: literal-union match + `_` wildcard.
const level = "warn" as "debug" | "info" | "warn" | "error";
expect("lit match", ((__m)=>{
    if (__m === "debug") {
        return 0;
    }
    if (__m === "info") {
        return 1;
    }
    if (__m === "warn") {
        return 2;
    }
    if (__m === "error") {
        return 3;
    }
    return __ztsAbsurd(__m);
})(level), 2);
const code = -1 as -1 | 0 | 1;
expect("neg lit match", ((__m)=>{
    if (__m === -1) {
        return "neg";
    }
    if (__m === 0) {
        return "zero";
    }
    if (__m === 1) {
        return "pos";
