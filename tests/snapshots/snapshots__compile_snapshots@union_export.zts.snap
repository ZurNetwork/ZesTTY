export type Level = 'info' | 'warn' | 'error';
export const Level = {
    values: [
        'info',
        'warn',
        'error'
    ] as const,
    has: (__ztsRaw: string): __ztsRaw is Level =>Level.values.indexOf(__ztsRaw as Level) !== -1
};
// Hoisting: use-before-declaration works, and export covers both halves.
const early = Level.has('warn');
console.log(early, Level.values);
