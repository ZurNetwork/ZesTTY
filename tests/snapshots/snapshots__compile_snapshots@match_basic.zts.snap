    kind: "Circle";
    radius: number;
} | {
    kind: "Square";
    side: number;
};
const PI = 3.141592653589793;
declare const shape: Shape;
const area = (()=>{
    const __m = shape;
    if (__m.kind === "Circle") {
        const { radius } = __m;
        return PI * radius ** 2;
    }
    if (__m.kind === "Square") {
        const { side } = __m;
        return side ** 2;
    }
    return __ztsAbsurd(__m);
})();
console.log(area);
