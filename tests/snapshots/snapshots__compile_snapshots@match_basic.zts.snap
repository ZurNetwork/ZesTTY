function __ztsAbsurd(x: never): never {
    throw {
        name: "ZtsNonExhaustiveMatch",
        message: "zts: non-exhaustive match",
        kind: x
    };
}
function __ztsMatch<T, R>(v: T, f: (v: T) => R): R {
    return f(v);
}
type Shape = {
    kind: "Circle";
    radius: number;
} | {
    kind: "Square";
    side: number;
};
const PI = 3.141592653589793;
declare const shape: Shape;
const area = __ztsMatch(shape, (__m)=>{
    const __k = __m.kind;
    if (__k === "Circle") {
        const { radius } = __m;
        return PI * radius ** 2;
    }
    if (__k === "Square") {
        const { side } = __m;
        return side ** 2;
    }
    return __ztsAbsurd(__k);
});
console.log(area);
