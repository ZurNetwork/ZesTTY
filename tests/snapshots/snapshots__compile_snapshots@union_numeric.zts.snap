const Mask = {
    values: [
        -0x10,
        0x10,
        1e2
    ] as const,
    has: (__ztsRaw: number): __ztsRaw is Mask =>Mask.values.indexOf(__ztsRaw as Mask) !== -1
};
// The wire-normalizer, unchanged in shape: has() narrows a raw number to
// the vocabulary type, so the fail-closed mapping is one expression.
export function toHttpStatus(raw: number): HttpStatus {
    return HttpStatus.has(raw) ? raw : 500;
}
// The closed side stays exhaustively matchable — literal arms here, the
// composition fixture covers range arms.
export function describe(s: HttpStatus): string {
    return ((__m)=>{
        if (__m === 200) {
            return "ok";
        }
        if (__m === 201) {
            return "created";
        }
        if (__m === 404) {
            return "not found";
        }
        if (__m === 500) {
            return "server error";
        }
        return __ztsAbsurd(__m);
    })(s);
}
// Impls keep working on a numeric union (Phase 7 item 5): the methods
// merge into the same factory const, next to `values` and `has`.
interface Display<Self> {
    fmt(self: Self): string;
}
console.log(HttpStatus.values.length, HttpStatus.fmt(toHttpStatus(404)), Offset.has(-1), Only.values[0], describe(200));
