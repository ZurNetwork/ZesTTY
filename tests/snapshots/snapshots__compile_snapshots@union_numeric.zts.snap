import { __ztsAbsurd } from "@zestty/core";
// Closed NUMERIC vocabulary (0.5.0): the same type + values + guard the
// string form gives, with `has` taking a `number`. This is what makes the
// range-pattern payload reachable — a closed numeric literal union is
// something zts could not declare before.
type HttpStatus = 200 | 201 | 404 | 500;
const HttpStatus = {
    values: [
        200,
        201,
        404,
        500
    ] as const,
    has: (__ztsRaw: number): __ztsRaw is HttpStatus =>HttpStatus.values.indexOf(__ztsRaw as HttpStatus) !== -1,
    fmt (self: HttpStatus): string {
        return `HTTP ${self}`;
    }
} satisfies {
    [key: string]: unknown;
} & Display<HttpStatus>;
// Negative members, and the single-member degenerate case. A negative
// member keeps the notation the author chose on BOTH planes — `-0x10`
// stays hexadecimal in the type alias, not re-rendered as `-16`.
type Offset = -1 | 0 | 1;
const Offset = {
    values: [
        -1,
        0,
        1
    ] as const,
    has: (__ztsRaw: number): __ztsRaw is Offset =>Offset.values.indexOf(__ztsRaw as Offset) !== -1
};
type Only = 7;
const Only = {
    values: [
        7
    ] as const,
    has: (__ztsRaw: number): __ztsRaw is Only =>Only.values.indexOf(__ztsRaw as Only) !== -1
