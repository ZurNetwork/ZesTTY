source: tests/snapshots.rs
expression: out.code
input_file: tests/fixtures/impl_coherence.zts
---
type Robot = {
    readonly kind: "Unit";
    readonly id: number;
};
const Robot = {
    Unit: (id: number): Robot =>({
            kind: "Unit",
            id
        }),
    describe (self: Robot): string {
        return "friend";
    },
    describe (self: Robot): string {
        return "device";
    }
} satisfies {
    [key: string]: unknown;
} & Human<Robot> & Machine<Robot>;
// Coherence by emit shape: two traits both demanding `describe` merge as
// duplicate object keys — tsc rejects the generated factory (TS1117),
// with no checking on the zts side. Exercised by the tsc exit test.
interface Human<Self> {
    describe(self: Self): string;
}
interface Machine<Self> {
    describe(self: Self): string;
}
