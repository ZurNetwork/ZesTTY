{
  "name": "@zestty/core",
  "version": "0.3.0",
  "description": "zts runtime core: Result<T, E> with Ok/Err constructors and map/map_err combinators, using the zts `kind` discriminant convention.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../node_modules/.bin/tsc index.ts --outDir dist --declaration --module esnext --target es2022 --strict",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZurNetwork/ZesTTY.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
