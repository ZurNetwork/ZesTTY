{
  "name": "@zestty/check",
  "version": "0.2.0",
  "description": "zts-check: the CI type gate for zts. Compiles .zts/.ztsx (and <script lang=\"zts\"> blocks) into shadow twins, runs tsc --noEmit, and remaps every diagnostic back to the original zts source through the sourcemaps.",
  "type": "module",
  "bin": {
    "zts-check": "./bin.js"
  },
  "main": "lib.js",
  "exports": {
    ".": "./lib.js",
    "./shadow": "./shadow.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@zestty/native": "^0.2.0",
    "source-map-js": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "devDependencies": {
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZurNetwork/ZesTTY.git",
    "directory": "packages/check"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin.js",
    "lib.js",
    "shadow.js"
  ]
}
