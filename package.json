{
  "name": "zestty-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "zts: a Rust-flavored superset of TypeScript. Compiler-level safety, ergonomic Rust patterns.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "editors/vscode",
    "bench"
  ],
  "scripts": {
    "build:native": "cargo build -p zestty-napi --release && cp target/release/libzestty_napi.so packages/zestty-native/zestty.linux-x64-gnu.node",
    "bench": "node bench/run.js",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "prettier": "^3.6.0"
  }
}
