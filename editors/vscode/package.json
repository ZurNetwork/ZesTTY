{
  "name": "zestty",
  "displayName": "ZesTTY",
  "description": "Language support for ZesTTY (zts) \u2014 a Rust-flavored superset of TypeScript with compiler-enforced exhaustiveness.",
  "version": "0.2.0",
  "publisher": "zurnetwork",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZurNetwork/ZesTTY.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zts",
        "aliases": [
          "ZesTTY",
          "zts"
        ],
        "extensions": [
          ".zts",
          ".ztsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zts",
        "scopeName": "source.zts",
        "path": "./syntaxes/zts.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.ts": "typescript"
        }
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "typescript-zestty-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "configuration": {
      "title": "ZesTTY",
      "properties": {
        "zestty.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to @zestty/language-server server.js. Auto-detected from the workspace when empty.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "main": "./client.js",
  "activationEvents": [
    "onLanguage:zts"
  ],
  "dependencies": {
    "typescript-zestty-plugin": "^0.3.0",
    "vscode-languageclient": "^9.0.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ZesTTY runs a workspace-provided language server (like typescript.tsdk); it stays disabled in Restricted Mode."
    }
  }
}
