{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZesTTY",
  "scopeName": "source.zts",
  "patterns": [
    {
      "include": "#zts-match-expression"
    },
    {
      "include": "#zts-enum-declaration"
    },
    {
      "include": "#zts-impl-declaration"
    },
    {
      "include": "#zts-union-declaration"
    },
    {
      "include": "#zts-newtype-declaration"
    },
    {
      "include": "#zts-not-operator"
    },
    {
      "include": "source.ts"
    }
  ],
  "repository": {
    "zts-match-expression": {
      "comment": "`match (expr) {` \u2014 contextual keyword; `.match(` stays a method call",
      "match": "(?<![.$])\\b(match)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.control.match.zts"
        }
      }
    },
    "zts-enum-declaration": {
      "comment": "zts enum with data-carrying variants: enum Name { Variant { field: Type } }",
      "begin": "(?<![.$])\\b(enum)\\s+([A-Za-z_$][\\w$]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.enum.zts"
        },
        "2": {
          "name": "entity.name.type.enum.zts"
        },
        "3": {
          "name": "punctuation.definition.block.zts"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.zts"
        }
      },
      "patterns": [
        {
          "comment": "variant name before its field block",
          "match": "\\b([A-Za-z_$][\\w$]*)\\b(?=\\s*\\{)",
          "name": "entity.name.type.variant.zts"
        },
        {
          "comment": "field: Type inside a variant body",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#zts-balanced-braces"
            },
            {
              "match": "\\b([A-Za-z_$][\\w$]*)\\s*(:)",
              "captures": {
                "1": {
                  "name": "variable.object.property.zts"
                },
                "2": {
                  "name": "punctuation.separator.key-value.zts"
                }
              }
            },
            {
              "include": "source.ts#type"
            },
            {
              "include": "source.ts"
            }
          ]
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "zts-impl-declaration": {
      "comment": "`impl Trait for Type {` — contextual, same-line-identifier commit rule as `union`/`newtype` (mirrors parser/zts.rs parse_ts_decl's \"impl\" arm); members are bare TS-style methods since 0.4.0 (`fn` removed — issue #60); bare `self` gets a language-variable scope inside this block only",
      "begin": "(?<![.$])\\b(impl)\\b\\s+([A-Za-z_$][\\w$]*)\\s+\\b(for)\\b\\s+([A-Za-z_$][\\w$]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.impl.zts"
        },
        "2": {
          "name": "entity.name.type.trait.zts"
        },
        "3": {
          "name": "keyword.control.for.zts"
        },
        "4": {
          "name": "entity.name.type.zts"
        },
        "5": {
          "name": "punctuation.definition.block.zts"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.zts"
        }
      },
      "patterns": [
        {
          "comment": "bare `self` receiver (no type annotation allowed in source)",
          "match": "\\b(self)\\b(?=\\s*[,)])",
          "name": "variable.language.self.zts"
        },
        {
          "include": "#zts-balanced-braces"
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "zts-union-declaration": {
      "comment": "`union Name = 'a' | 'b';` — contextual, same-line identifier + `=` commits (mirrors the `type`-alias rule; `const union = 2;` stays vanilla)",
      "match": "(?<![.$])\\b(union)\\b\\s+([A-Za-z_$][\\w$]*)\\b(?=\\s*=)",
      "captures": {
        "1": {
          "name": "storage.type.union.zts"
        },
        "2": {
          "name": "entity.name.type.zts"
        }
      }
    },
    "zts-newtype-declaration": {
      "comment": "`newtype Id = string;` — contextual, same-line identifier + `=` commits (mirrors the `type`-alias rule; `const newtype = 2;` stays vanilla)",
      "match": "(?<![.$])\\b(newtype)\\b\\s+([A-Za-z_$][\\w$]*)\\b(?=\\s*=)",
      "captures": {
        "1": {
          "name": "storage.type.newtype.zts"
        },
        "2": {
          "name": "entity.name.type.zts"
        }
      }
    },
    "zts-not-operator": {
      "comment": "`not` — RESERVED word since 0.4.0 (issue #60): always the negation operator in expression position, including `not(x)` and `not (x)`. Property positions (`obj.not`, `{ not: 1 }`) stay uncolored via the [.$] guard; a `:` right after means a property key, also uncolored.",
      "match": "(?<![.$])\\b(not)\\b(?![ \\t]*:)",
      "captures": {
        "1": {
          "name": "keyword.operator.not.zts"
        }
      }
    },
    "zts-balanced-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#zts-balanced-braces"
        },
        {
          "include": "source.ts"
        }
      ]
    }
  }
}
